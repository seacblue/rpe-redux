{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RPE Redux",
  "version": "1.0.9",
  "identifier": "io.rperedux.editor",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "node scripts/buildDocsSite.mjs && vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RPE Redux",
        "width": 1440,
        "height": 810,
        "minWidth": 1000,
        "minHeight": 680,
        "visible": false,
        "dragDropEnabled": true,
        "decorations": false,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost redux: http://redux.localhost http://127.0.0.1:* http://localhost:* blob: data:; media-src 'self' redux: http://redux.localhost http://127.0.0.1:* http://localhost:* blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost redux: http://redux.localhost http://127.0.0.1:* http://localhost:* ws: wss: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'self'; frame-ancestors 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5QjdDRDhDOEJFN0U2NzMKUldSejV1ZUxqTTIzQ1RBbm9VWnRETWwvTXhwOVpsVUFqMEw3dmpVSTNpQ1ZWak5BaW9HZnlWRUkK",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SOLST-II",
    "targets": "all",
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../dist/themes": "themes",
      "../dist/skins": "skins",
      "../dist/extensions": "extensions",
      "../docs-site-dist": "docs-site-dist",
      "resources/redux-service*": "resources/",
      "resources/cloudflared/**/*": "resources/cloudflared/",
      "resources/ffmpeg/**/*": "resources/ffmpeg/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installMode": "currentUser",
        "installerHooks": "nsis/installer.nsh",
        "startMenuFolder": "RPE Redux",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "nsis/uninstaller.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "uninstallerHeaderImage": "nsis/header.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
