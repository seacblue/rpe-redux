{
  "name": "rpe-redux",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "RPE Redux desktop chart editor with RPE chart compatibility",
  "author": "cmdysj",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:desktop": "node scripts/desktop.mjs",
    "dev:server": "go -C src/backend run ./cmd/redux-service",
    "dev:collab": "node scripts/collaborationServer.mjs",
    "build": "node scripts/buildDesktop.mjs",
    "build:web": "vite build",
    "build:server": "node src/backend/build.ts",
    "build:docs": "node scripts/buildDocsSite.mjs",
    "build:icons": "node scripts/buildThemeIcons.mjs",
    "test:unit": "node --test \"src/test/**/*.test.mjs\"",
    "test:server": "go -C src/backend test ./...",
    "smoke": "node scripts/smoke.mjs",
    "icons:check": "node scripts/checkThemeIcons.mjs",
    "icons:export": "node scripts/exportIconSet.mjs",
    "check": "npm run check:types && npm run check:lint && npm run check:style && npm run check:docs && npm run check:icons && npm run check:sdk && npm run check:extensions && npm run test:unit && npm run test:server",
    "check:types": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsconfig.tsbuildinfo",
    "check:lint": "eslint . --cache --cache-location node_modules/.cache/eslint.cache",
    "check:style": "node scripts/checkStyleRules.mjs && node scripts/checkStylesCompile.mjs",
    "check:docs": "node scripts/checkDocumentation.mjs",
    "check:icons": "npm run icons:check",
    "check:sdk": "tsc -p sdk/tsconfig.json --incremental --tsBuildInfoFile node_modules/.cache/sdk.tsbuildinfo",
    "check:extensions": "node scripts/checkExtensionMethods.mjs",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo check --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run check && prettier --check --cache --cache-location node_modules/.cache/prettier-cache \"src/**/*.{ts,tsx,less,mjs}\" \"scripts/**/*.mjs\" \"**/*.md\" \"sdk/**/*.{ts,js,json,md}\" \"*.{html,json,js,ts}\"",
    "fix": "eslint . --fix && prettier --write \"src/**/*.{ts,tsx,less,mjs}\" \"scripts/**/*.mjs\" \"**/*.md\" \"sdk/**/*.{ts,js,json,md}\" \"*.{html,json,js,ts}\""
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/plugin-syntax-jsx": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "less": "^4.9.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.1"
  }
}
